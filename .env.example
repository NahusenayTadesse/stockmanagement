# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Outgoing mail (password resets, alerts). Without SMTP_HOST, SMTP_USER and SMTP_PASSWORD the
# app runs normally and sends nothing.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS_SERVERNAME=""
SMTP_FROM=""

# Daily expiry digest: POST /api/cron/expiry-digest with "Authorization: Bearer <CRON_SECRET>".
# Leave empty to switch the endpoint off.
CRON_SECRET=""

# Encrypts stored credentials (e-invoicing secret, fiscal bridge token, device operator password).
# Falls back to BETTER_AUTH_SECRET; changing it makes stored credentials unreadable.
SECRETS_KEY=""

# SMS through GeezSMS (https://geezsms.com): the account's API token. Empty: no texts are sent.
SMS_KEY=
# true: messages are written to the SMS log but not sent. Use it anywhere the customer numbers
# are demo data that may belong to real people.
SMS_DRY_RUN=

# --- Production only (systemd EnvironmentFile on the server; see "Deploying" in the README) ---
# adapter-node listener. Bound to loopback; OpenLiteSpeed proxies the public hostname to it.
# PORT="3020"
# HOST="127.0.0.1"
# Where uploads (logos, import files) are written. Defaults to `.tempFiles` in the working
# directory; on the server point it outside build/, which every deploy replaces.
# FILES_DIR="/home/admin/apps/stock-management/.tempFiles"
# adapter-node reads at most 512K of a request body by default and drops anything larger
# silently — the form comes back invalid with no field errors. Excel imports and logos need more.
# BODY_SIZE_LIMIT="10M"
