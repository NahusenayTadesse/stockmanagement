# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Outgoing mail (password resets, alerts). Without SMTP_HOST, SMTP_USER and SMTP_PASSWORD the
# app runs normally and sends nothing.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS_SERVERNAME=""
SMTP_FROM=""

# Daily expiry digest: POST /api/cron/expiry-digest with "Authorization: Bearer <CRON_SECRET>".
# Leave empty to switch the endpoint off.
CRON_SECRET=""

# Encrypts stored credentials (e-invoicing secret, fiscal bridge token, device operator password).
# Falls back to BETTER_AUTH_SECRET; changing it makes stored credentials unreadable.
SECRETS_KEY=""
